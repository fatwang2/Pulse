# Copy to .env.release and keep the real file out of git.
#
# This file configures a LOCAL build of the release pipeline, which builds,
# signs, notarizes, and verifies but never publishes: uploads happen only from
# a GitHub Actions run (see "Releasing" in README.md). A runner ignores this
# file entirely and reads repository secrets instead.

# Apple Developer ID signing and notarization.
DEVELOPMENT_TEAM=XXXXXXXXXX
APPLE_SIGNING_IDENTITY="Developer ID Application: YOUR NAME (XXXXXXXXXX)"
APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
APPLE_API_KEY="XXXXXXXXXX"
APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"

# GitHub Releases target. Required because the Pulse repo may not have a git remote yet.
GH_REPO="fatwang2/Pulse"

# Sparkle update feed. The release script maintains this asset on the stable
# `appcast` GitHub Release tag by default.
SPARKLE_FEED_URL="https://github.com/fatwang2/Pulse/releases/download/appcast/appcast.xml"
SPARKLE_PUBLIC_ED_KEY="SEERlHb3nTm1HQjbHoxeWmIED6ZVjRRsAo8Ez1lJ8V8="

# TelemetryDeck app identifier. This identifier is embedded in the app and is not a secret.
# Leave empty to build Pulse with anonymous usage analytics disabled.
TELEMETRYDECK_APP_ID=""

# Optional. If set, release-mac.sh imports the private EdDSA key into the
# keychain before generating the appcast. Do not commit the private key.
# SPARKLE_PRIVATE_KEY_FILE="$HOME/.config/pulse/sparkle_private_key"

# Optional. The exported EdDSA key itself (generate_keys -x), piped to
# generate_appcast on standard input so it never touches disk. This is how the
# key reaches a runner as the SPARKLE_PRIVATE_KEY secret; locally the keychain
# is usually the better place for it.
# SPARKLE_PRIVATE_KEY=""

# Optional. Directory containing Sparkle's generate_appcast and generate_keys tools.
# SPARKLE_BIN="/path/to/Sparkle/bin"
