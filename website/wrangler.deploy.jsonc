// Production deploy config for Cloudflare Workers (self-hosted, migrated off ChatGPT Sites).
// Deploy with: npm run build && npx wrangler deploy --config wrangler.deploy.jsonc
// Kept separate from vite.config.ts local bindings so `npm run dev` behavior is unchanged.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulse-website",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // The vinext build output is pre-bundled; upload its module graph as-is.
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "DOWNLOADS", "bucket_name": "pulse-downloads" }
  ],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [
    { "pattern": "www.pulseticker.app", "custom_domain": true },
    { "pattern": "pulseticker.app", "custom_domain": true }
  ]
}
